# Kopieer naar backend/.env voor lokaal draaien. Zet in productie deze waarden als
# omgevingsvariabelen/secrets bij je hosting (Cloud Run), niet in de code.

# MongoDB Atlas-verbinding (Database > Connect > Drivers)
MONGO_URL=mongodb+srv://GEBRUIKER:WACHTWOORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=huishoudboekje

# Willekeurige geheime sleutel van minimaal 32 tekens, bijv.:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# OAuth Client ID uit Google Cloud (Web application)
GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Wie altijd mag inloggen (komma-gescheiden). Je partner krijgt toegang via een uitnodiging.
ALLOWED_EMAILS=jouw.naam@gmail.com

# Publiek adres van de app (voor uitnodigingslinks), zonder / aan het eind
APP_URL=https://huishoudboekje-xxxxx.europe-west4.run.app

# Lokaal via http://localhost: zet op false. In productie (https) weglaten of true.
COOKIE_SECURE=true

# Alleen bij lokaal ontwikkelen met de React-devserver op een andere poort:
# CORS_ORIGINS=http://localhost:3000

# Optioneel: uitnodigingen per e-mail via resend.com (anders deel je de link zelf)
# RESEND_API_KEY=
# EMAIL_FROM=Huishoudboekje <noreply@jouwdomein.nl>
