{
  "name": "Huishoudboekje demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "cd frontend && yarn install --non-interactive",
  "postAttachCommand": "cd frontend && BROWSER=none yarn start:demo",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Huishoudboekje demo", "onAutoForward": "openBrowser" }
  }
}
